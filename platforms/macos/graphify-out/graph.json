ull,"community":1,"community_name":"macOS Graph Navigation","contributor":null,"file_type":"rationale","norm_label":"report for broad architecture","rationale":"- Read graphify-out/GRAPH_REPORT.md only for broad architecture review or when query/path/explain do not surface enough context.","source_file":"AGENTS.md","source_location":"L18","source_url":null},{"id":"agents_whole_graph_diff","label":"Whole Graph Rewrite Expected","_origin":"semantic","author":null,"captured_at":null,"community":1,"community_name":"macOS Graph Navigation","contributor":null,"file_type":"rationale","norm_label":"whole graph rewrite expected","rationale":"- A committed graphify-out/graph.json is rewritten whole on every build, so a large diff to it in a pull request is expected. Do not flag it as churn or suggest skipping the graph rebuild or its hooks.","source_file":"AGENTS.md","source_location":"L20","source_url":null},{"id":"agents_wiki_navigation","label":"Graph Wiki Navigation","_origin":"semantic","author":null,"captured_at":null,"community":1,"community_name":"macOS Graph Navigation","contributor":null,"file_type":"rationale","norm_label":"graph wiki navigation","rationale":"- If graphify-out/wiki/index.md exists, use it for broad navigation instead of raw source browsing.","source_file":"AGENTS.md","source_location":"L17","source_url":null},{"id":"readme_appkit","label":"AppKit Native Surfaces","_origin":"semantic","author":null,"captured_at":null,"community":2,"community_name":"macOS Native Pilot","contributor":null,"file_type":"concept","norm_label":"appkit native surfaces","source_file":"README.md","source_location":"L7","source_url":null},{"id":"readme_minimum_os","label":"macOS 14 Sonoma Minimum","_origin":"semantic","author":null,"captured_at":null,"community":2,"community_name":"macOS Native Pilot","contributor":null,"file_type":"concept","norm_label":"macos 14 sonoma minimum","source_file":"README.md","source_location":"L7","source_url":null},{"id":"readme_pilot_decision"