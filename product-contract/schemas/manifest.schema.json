{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xerahs.com/schemas/product-contract-manifest.schema.json",
  "title": "XerahS Product Contract manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "status", "capabilities"],
  "properties": {
    "contract_version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "status": { "enum": ["seed", "draft", "active", "retired"] },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "version", "status", "requirements"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+-[0-9]{3}$" },
          "path": { "type": "string", "pattern": "^capabilities/" },
          "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
          "status": { "enum": ["planned", "draft", "approved", "active", "retired"] },
          "requirements": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*-[0-9]{3}$" } }
        }
      }
    }
  }
}
