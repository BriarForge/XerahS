{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xerahs.com/schemas/product-contract-approval-record-v1.json",
  "title": "XerahS Product Contract approval record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "decision_id", "recorded_on", "authority", "source", "decision", "scope", "effects", "remaining_gates"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schema_version": { "const": 1 },
    "decision_id": { "type": "string", "pattern": "^APPROVAL-[0-9]{4}-[0-9]{2}-[0-9]{2}-[A-Z0-9-]+$" },
    "recorded_on": { "type": "string", "format": "date" },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "identity"],
      "properties": {
        "role": { "const": "human-product-owner" },
        "identity": { "type": "string", "minLength": 1 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "statement"],
      "properties": {
        "kind": { "enum": ["interactive-instruction", "signed-document", "review-system"] },
        "statement": { "type": "string", "minLength": 1 }
      }
    },
    "decision": { "enum": ["approved", "rejected", "revision-requested", "withdrawn"] },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "packages"],
      "properties": {
        "contract_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "packages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+-[0-9]{3}$" }
        }
      }
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["normative_contract", "implementation_authorized", "activation_authorized", "census_closed", "release_authorized"],
      "properties": {
        "normative_contract": { "type": "boolean" },
        "implementation_authorized": { "type": "boolean" },
        "activation_authorized": { "type": "boolean" },
        "census_closed": { "type": "boolean" },
        "release_authorized": { "type": "boolean" }
      }
    },
    "remaining_gates": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
