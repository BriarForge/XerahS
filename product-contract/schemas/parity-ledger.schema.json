{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xerahs.com/schemas/parity-ledger.schema.json",
  "title": "XerahS parity ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "baseline", "ledger", "items"],
  "properties": {
    "schema_version": { "const": 1 },
    "baseline": { "type": "string", "pattern": "^[a-z0-9.-]+$" },
    "ledger": { "enum": ["capability", "settings", "workflow", "interface", "compatibility"] },
    "items": { "type": "array", "items": { "$ref": "#/$defs/item" } }
  },
  "$defs": {
    "item": {
      "type": "object",
      "required": ["id", "domain", "user_outcome", "classification", "source_evidence", "baseline_commit", "contract", "platforms", "evidence", "compatibility", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z0-9]+(?:-[A-Z0-9]+)+-[0-9]{3}$" },
        "domain": { "type": "string", "minLength": 1 },
        "user_outcome": { "type": "string", "minLength": 1 },
        "classification": { "enum": ["preserve", "native-equivalent", "correct-defect", "retire-intentionally", "not-applicable", "out-of-scope-bxip001"] },
        "source_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "symbol"],
            "properties": { "path": { "type": "string", "minLength": 1 }, "symbol": { "type": "string", "minLength": 1 } }
          }
        },
        "baseline_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "contract": { "type": ["string", "null"] },
        "platforms": { "$ref": "#/$defs/platforms" },
        "evidence": { "type": "object" },
        "compatibility": { "type": "array" },
        "status": { "enum": ["discovered", "inventoried", "contracted", "implemented", "conformant", "release-verified"] }
      }
    },
    "platforms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["windows", "macos", "linux"],
      "properties": {
        "windows": { "$ref": "#/$defs/disposition" },
        "macos": { "$ref": "#/$defs/disposition" },
        "linux": { "$ref": "#/$defs/disposition" }
      }
    },
    "disposition": { "enum": ["required", "equivalent", "degraded", "unavailable", "not-applicable"] }
  }
}
