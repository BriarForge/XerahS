      "input": { "mode": "filename", "pattern": "%h%pm", "context": { "local_time": "2026-08-30T12:05:00+08:00", "unix_time": 1788062700, "locale": "en-AU", "counter": 0 } },
      "expected": { "value": "12PM", "next_counter": 0 }
    },
    {
      "id": "calendar-names-and-week",
      "requirements": ["FN-002", "FN-020"],
      "input": { "mode": "filename", "pattern": "%w_%w2_%mon_%mon2_%wy_%yy", "context": { "local_time": "2026-08-30T17:04:05.123+08:00", "unix_time": 1788080645, "locale": "en-AU", "counter": 0 } },
      "expected": { "value": "Sunday_Sunday_August_August_35_26", "next_counter": 0 }
