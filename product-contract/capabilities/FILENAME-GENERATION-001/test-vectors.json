{
  "schema_version": 2,
  "capability": "FILENAME-GENERATION-001",
  "operation": "expand",
  "comparison": "exact",
  "requirement_ids": ["FN-001", "FN-002", "FN-003", "FN-004", "FN-005", "FN-006", "FN-007", "FN-008", "FN-009", "FN-010", "FN-011", "FN-012", "FN-013", "FN-014", "FN-015", "FN-016", "FN-017", "FN-018", "FN-019", "FN-020", "FN-021", "FN-022", "FN-023", "FN-024", "FN-025", "FN-026", "FN-027"],
  "vectors": [
    {
      "id": "date-counter",
      "requirements": ["FN-002", "FN-004", "FN-007", "FN-018"],
      "input": { "mode": "filename", "pattern": "%y-%mo-%d_%h-%mi-%s_%widthx%height_%i{3}", "context": { "local_time": "2026-08-30T17:04:05.123+08:00", "unix_time": 1788080645, "locale": "en-AU", "counter": 7, "width": 1920, "height": 1080 } },
      "expected": { "value": "2026-08-30_17-04-05_1920x1080_008", "next_counter": 8 }
    },
    {
      "id": "twelve-hour",
      "requirements": ["FN-003", "FN-020"],
      "input": { "mode": "filename", "pattern": "%h-%mi%pm", "context": { "local_time": "2026-08-30T17:04:05.123+08:00", "unix_time": 1788080645, "locale": "en-AU", "counter": 0 } },
      "expected": { "value": "05-04PM", "next_counter": 0 }
    },
    {
      "id": "twelve-hour-midnight-and-milliseconds",
      "requirements": ["FN-002", "FN-003", "FN-020"],
      "input": { "mode": "filename", "pattern": "%h%mi%s%ms%pm", "context": { "local_time": "2026-08-30T00:30:09.007+08:00", "unix_time": 1788021009, "locale": "en-AU", "counter": 0 } },
      "expected": { "value": "123009007AM", "next_counter": 0 }
    },
    {
      "id": "twelve-hour-noon",
      "requirements": ["FN-003", "FN-020"],
      "input": { "mode": "filename", "pattern": "%h%pm", "context": { "local_time": "2026-08-30T12:05:00+08:00", "unix_time": 1788062700, "locale": "en-AU", "counter": 0 } },
      "expected": { "value": "12PM", "next_counter": 0 }
    },
    {
      "id": "calendar-names-and-week",
      "requirements": ["FN-002", "FN-020"],
      "input": { "mode": "filename", "pattern": "%w_%w2_%mon_%mon2_%wy_%yy", "context": { "local_time": "2026-08-30T17:04:05.123+08:00", "unix_time": 1788080645, "locale": "en-AU", "counter": 0 } },
      "expected": { "value": "Sunday_Sunday_August_August_35_26", "next_counter": 0 }
    },
    {
      "id": "unix-seconds",
      "requirements": ["FN-002", "FN-020"],
      "input": { "mode": "text", "pattern": "%unix", "context": { "local_time": "2026-08-30T17:04:05.123+08:00", "unix_time": 1788080645, "locale": "en-AU", "counter": 0 } },
      "expected": { "value": "1788080645", "next_counter": 0 }
    },
    {
