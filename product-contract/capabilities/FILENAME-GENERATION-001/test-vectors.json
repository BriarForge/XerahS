      "requirements": ["FN-002", "FN-004", "FN-007", "FN-018"],
      "input": { "mode": "filename", "pattern": "%y-%mo-%d_%h-%mi-%s_%widthx%height_%i{3}", "context": { "local_time": "2026-08-30T17:04:05.123+08:00", "unix_time": 1788080645, "locale": "en-AU", "counter": 7, "width": 1920, "height": 1080 } },
      "expected": { "value": "2026-08-30_17-04-05_1920x1080_008", "next_counter": 8 }
    },
    {
      "id": "twelve-hour",
      "requirements": ["FN-003", "FN-020"],
      "input": { "mode": "filename", "pattern": "%h-%mi%pm", "context": { "local_time": "2026-08-30T17:04:05.123+08:00", "unix_time": 1788080645, "locale": "en-AU", "counter": 0 } },
      "expected": { "value": "05-04PM", "next_counter": 0 }
    },
    {
