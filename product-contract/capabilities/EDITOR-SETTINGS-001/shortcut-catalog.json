{
  "schema_version": 1,
  "status": "draft-native-equivalence-pending-product-owner-approval",
  "precedence": ["active-text-entry", "modal-dialog", "active-effect-panel", "live-crop-or-gesture", "user-tool-hotkey", "editor-action"],
  "bindings": [
    { "gesture": "Delete", "action": "delete-selection" },
    { "gesture": "Shift+Delete", "action": "clear-annotations" },
    { "gesture": "Ctrl+Z", "action": "undo" },
    { "gesture": "Ctrl+Y", "action": "redo" },
    { "gesture": "Ctrl+Shift+Z", "action": "redo" },
    { "gesture": "Ctrl+X", "action": "cut-annotation" },
    { "gesture": "Ctrl+Shift+C", "action": "copy-annotation" },
    { "gesture": "Ctrl+C", "action": "copy-rendered-image" },
    { "gesture": "Ctrl+V", "action": "paste" },
    { "gesture": "Ctrl+D", "action": "duplicate-selection" },
    { "gesture": "Ctrl+S", "action": "save" },
    { "gesture": "Ctrl+Shift+S", "action": "save-as" },
    { "gesture": "Ctrl+N", "action": "new-image" },
    { "gesture": "Ctrl+O", "action": "open-image" },
    { "gesture": "Ctrl+P", "action": "pin-to-screen" },
    { "gesture": "Ctrl+Shift+P", "action": "print" },
    { "gesture": "Ctrl+U", "action": "upload" },
    { "gesture": "Ctrl+H", "action": "toggle-toolbars" },
    { "gesture": "Ctrl+Shift+F", "action": "flatten-image" },
    { "gesture": "Arrow", "action": "move-selection-1-pixel" },
    { "gesture": "Shift+Arrow", "action": "move-selection-10-pixels" },
    { "gesture": "Home", "action": "bring-to-front" },
    { "gesture": "End", "action": "send-to-back" },
    { "gesture": "PageUp", "action": "bring-forward" },
    { "gesture": "PageDown", "action": "send-backward" },
    { "gesture": "Enter", "action": "confirm-crop-or-continue-task" },
    { "gesture": "Escape", "action": "close-modal-effect-crop-selection-or-session-in-precedence-order" },
    { "gesture": "Ctrl+Wheel", "action": "zoom-at-pointer" }
  ]
}
