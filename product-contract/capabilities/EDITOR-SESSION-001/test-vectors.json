{
  "schema_version": 2,
  "capability": "EDITOR-SESSION-001",
  "comparison": "subset",
  "notes": "Operations: history applies ops to a new session over a source of source_size (create-rectangle selects the new object; select takes ids by creation index or [] for none; move-selection; set-stroke-width, set-stroke-color, set-fill-color, set-opacity; delete-selection; undo; redo; mark-saved records a successful persistence checkpoint). Reported rectangle fields describe the first annotation; tool_* fields describe tool defaults. render composites annotations over a solid source and reports pixels row by row as #AARRGGBB. parse-document validates a decoded .xann payload. round-trip parses and rewrites a payload. sidecar-path resolves the sidecar for a raster path given existing files. save-sidecar applies ES-014.",
  "requirement_ids": ["ES-003", "ES-005", "ES-006", "ES-009", "ES-010", "ES-014", "ES-015", "ES-017", "ES-022", "ES-023", "ES-024", "ES-025", "ES-026", "ES-027", "ES-028", "ES-029", "ES-030"],
  "vectors": [
    {
      "id": "reverse-drag-rectangle",
      "operation": "history",
      "requirements": ["ES-003", "ES-005", "ES-023", "ES-024"],
      "input": { "source_size": [800, 600], "operations": [{ "op": "create-rectangle", "start": [500, 400], "end": [100, 150] }] },
      "expected": { "annotation_count": 1, "selected_count": 1, "rectangle_bounds": [100, 150, 500, 400], "stroke_color": "#FFFF0000", "fill_color": "#00000000", "stroke_width": 4, "rotation_degrees": 0, "opacity": 1, "undo_count": 1, "redo_count": 0, "dirty": true }
    },
    {
      "id": "zero-area-rectangle-rejected",
      "operation": "history",
      "requirements": ["ES-003", "ES-005"],
      "input": { "source_size": [800, 600], "operations": [{ "op": "create-rectangle", "start": [200, 200], "end": [200, 350] }] },
      "expected": { "annotation_count": 0, "undo_count": 0, "redo_count": 0, "dirty": false }
    },
    {
      "id": "undo-redo-move",
      "operation": "history",
      "requirements": ["ES-005", "ES-006"],
      "input": {
        "source_size": [800, 600],
        "operations": [
          { "op": "create-rectangle", "start": [100, 150], "end": [500, 400] },
          { "op": "move-selection", "delta": [20, -10] },
          { "op": "undo" },
          { "op": "redo" }
        ]
      },
      "expected": { "rectangle_bounds": [120, 140, 520, 390], "undo_count": 2, "redo_count": 0, "dirty": true }
    },
    {
      "id": "branch-clears-redo",
      "operation": "history",
      "requirements": ["ES-006", "ES-026"],
      "input": {
        "source_size": [800, 600],
        "operations": [
          { "op": "create-rectangle", "start": [100, 150], "end": [500, 400] },
          { "op": "move-selection", "delta": [20, -10] },
          { "op": "undo" },
          { "op": "set-stroke-width", "value": 8 }
        ]
      },
      "expected": { "rectangle_bounds": [100, 150, 500, 400], "stroke_width": 8, "tool_stroke_width": 8, "undo_count": 2, "redo_count": 0, "dirty": true }
    },
    {
      "id": "selection-is-not-history",
      "operation": "history",
      "requirements": ["ES-026"],
      "input": {
        "source_size": [800, 600],
        "operations": [
          { "op": "create-rectangle", "start": [100, 150], "end": [500, 400] },
          { "op": "select", "ids": [] },
          { "op": "select", "ids": [0] },
          { "op": "select", "ids": [] }
        ]
      },
      "expected": { "selected_count": 0, "undo_count": 1, "redo_count": 0 }
    },
    {
      "id": "style-without-selection-changes-tool-only",
      "operation": "history",
      "requirements": ["ES-003", "ES-026"],
      "input": {
        "source_size": [800, 600],
        "operations": [
          { "op": "create-rectangle", "start": [100, 150], "end": [500, 400] },
          { "op": "select", "ids": [] },
          { "op": "set-stroke-width", "value": 8 },
          { "op": "create-rectangle", "start": [10, 10], "end": [50, 50] }
        ]
      },
      "expected": { "annotation_count": 2, "stroke_width": 4, "tool_stroke_width": 8, "second_stroke_width": 8, "undo_count": 2 }
    },
    {
      "id": "undo-to-checkpoint-is-clean",
      "operation": "history",
      "requirements": ["ES-027"],
      "input": {
        "source_size": [800, 600],
        "operations": [
          { "op": "create-rectangle", "start": [100, 150], "end": [500, 400] },
          { "op": "mark-saved" },
          { "op": "move-selection", "delta": [5, 5] },
          { "op": "undo" }
        ]
      },
      "expected": { "rectangle_bounds": [100, 150, 500, 400], "undo_count": 1, "redo_count": 1, "dirty": false }
    },
    {
      "id": "truncated-checkpoint-stays-dirty",
      "operation": "history",
      "requirements": ["ES-006", "ES-027"],
      "input": {
        "source_size": [800, 600],
        "operations": [
          { "op": "create-rectangle", "start": [100, 150], "end": [500, 400] },
          { "op": "move-selection", "delta": [5, 5] },
          { "op": "mark-saved" },
          { "op": "undo" },
          { "op": "set-stroke-width", "value": 6 },
          { "op": "undo" }
        ]
      },
      "expected": { "rectangle_bounds": [100, 150, 500, 400], "stroke_width": 4, "undo_count": 1, "redo_count": 1, "dirty": true }
    },
    {
      "id": "delete-and-undo-restores-selection",
      "operation": "history",
      "requirements": ["ES-006", "ES-007"],
      "input": {
        "source_size": [800, 600],
        "operations": [
          { "op": "create-rectangle", "start": [100, 150], "end": [500, 400] },
          { "op": "delete-selection" },
          { "op": "undo" }
        ]
      },
      "expected": { "annotation_count": 1, "selected_count": 1, "rectangle_bounds": [100, 150, 500, 400], "undo_count": 1, "redo_count": 1 }
    },
    {
      "id": "render-stroke-coverage",
      "operation": "render",
      "requirements": ["ES-009", "ES-010", "ES-025"],
      "input": {
        "source_size": [4, 4],
        "source_fill": "#FFFFFFFF",
        "annotations": [{ "type": "rectangle", "start": [1, 1], "end": [3, 3], "strokeColor": "#FFFF0000", "fillColor": "#00000000", "strokeWidth": 1, "rotationDegrees": 0, "opacity": 1 }]
      },
      "expected": {
        "pixels": [
          ["#FFFFBFBF", "#FFFF8080", "#FFFF8080", "#FFFFBFBF"],
