    {
      "id": "unknown-fields-and-types-round-trip",
      "operation": "round-trip",
      "requirements": ["ES-015"],
      "input": {
        "document": {
          "version": 1, "imagePath": "", "imageHash": "", "canvasWidth": 1, "canvasHeight": 1, "createdAt": "2026-08-30T00:00:00Z", "modifiedAt": "2026-08-30T00:00:00Z", "sourceImagePngBase64": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAAC0lEQVR42mP4DwQACfsD/Wj6HMwAAAAASUVORK5CYII=", "embeddedImages": {}, "futureField": { "a": 1 },
          "annotations": [ { "id": "0b3f7d0e-6c1b-4f5a-8d2e-9a4b1c7e5f10", "type": "hexagon", "sides": 6, "zIndex": 0 } ]
