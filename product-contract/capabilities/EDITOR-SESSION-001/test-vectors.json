            { "id": "6f1c1a52-0a1e-4c4e-9b0a-3d1f5f2a9c01", "type": "rectangle", "start": { "x": 2, "y": 2 }, "end": { "x": 6, "y": 6 }, "strokeColor": "#FFFF0000", "fillColor": "#00000000", "strokeWidth": 4, "rotationDegrees": 0 }
