          ["#FFFF8080", "#FFFF4040", "#FFFF4040", "#FFFF8080"],
          ["#FFFFBFBF", "#FFFF8080", "#FFFF8080", "#FFFFBFBF"]
        ]
      }
    },
    {
      "id": "render-opacity-applied-once",
      "operation": "render",
      "requirements": ["ES-010", "ES-025"],
      "input": {
        "source_size": [2, 2],
        "source_fill": "#FFFFFFFF",
        "annotations": [{ "type": "rectangle", "start": [0, 0], "end": [2, 2], "strokeColor": "#FFFF0000", "fillColor": "#FF0000FF", "strokeWidth": 1, "rotationDegrees": 0, "opacity": 0.5 }]
      },
      "expected": {
        "pixels": [
          ["#FFDF809F", "#FFDF809F"],
          ["#FFDF809F", "#FFDF809F"]
        ]
      }
    },
    {
      "id": "render-fill-with-opacity",
      "operation": "render",
      "requirements": ["ES-025"],
      "input": {
        "source_size": [2, 1],
        "source_fill": "#FFFFFFFF",
        "annotations": [{ "type": "rectangle", "start": [0, 0], "end": [2, 1], "strokeColor": "#00000000", "fillColor": "#FF0000FF", "strokeWidth": 1, "rotationDegrees": 0, "opacity": 0.5 }]
      },
      "expected": { "pixels": [["#FF8080FF", "#FF8080FF"]] }
    },
    {
      "id": "empty-document-removes-sidecar",
      "operation": "save-sidecar",
      "requirements": ["ES-014"],
      "input": { "existing_sidecar": true, "annotations": [], "sidecar_intent": true },
      "expected": { "sidecar_exists": false, "sidecar_path": null, "raster_untouched": true }
    },
    {
      "id": "newer-version-read-only-failure",
