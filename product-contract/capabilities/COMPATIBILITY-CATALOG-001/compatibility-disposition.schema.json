{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xerahs.com/schemas/compatibility-disposition-v1.json",
  "title": "XerahS compatibility disposition",
  "type": "object",
  "additionalProperties": false,
  "required": ["ledger_id", "format_id", "versions", "import", "export", "round_trip", "unknown_content", "secrets", "corruption", "fixtures", "runtime_observation", "status"],
  "properties": {
    "ledger_id": { "type": "string", "pattern": "^COMPAT-[A-Z0-9-]+-[0-9]{3}$" },
    "format_id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$" },
    "versions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "import": { "enum": ["required", "best-effort", "rejected", "not-applicable"] },
    "export": { "enum": ["required", "best-effort", "not-supported", "not-applicable"] },
    "round_trip": { "enum": ["semantic", "loss-reported", "not-supported", "not-applicable"] },
    "unknown_content": { "enum": ["retain", "quarantine", "reject", "not-applicable"] },
    "secrets": { "type": "string", "minLength": 1 },
    "corruption": { "type": "string", "minLength": 1 },
    "fixtures": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "runtime_observation": { "type": "string", "minLength": 1 },
    "status": { "enum": ["draft", "approved", "retired"] }
  }
}
