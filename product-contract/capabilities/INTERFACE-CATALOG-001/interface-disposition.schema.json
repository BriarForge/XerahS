{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xerahs.com/schemas/interface-disposition-v1.json",
  "title": "XerahS interface surface disposition",
  "type": "object",
  "additionalProperties": false,
  "required": ["ledger_id", "surface_id", "kind", "operation", "request_schema", "result_schema", "authority", "errors", "accessibility", "platforms", "status"],
  "properties": {
    "ledger_id": { "type": "string", "pattern": "^IF-[A-Z0-9-]+-[0-9]{3}$" },
    "surface_id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$" },
    "kind": { "enum": ["gui", "cli", "mcp", "destination"] },
    "operation": { "type": "string", "minLength": 1 },
    "request_schema": { "type": "string", "minLength": 1 },
    "result_schema": { "type": "string", "minLength": 1 },
    "authority": { "type": "string", "minLength": 1 },
    "errors": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "accessibility": { "type": "string", "minLength": 1 },
    "platforms": {
      "type": "object",
      "required": ["windows", "macos", "linux"],
      "additionalProperties": false,
      "properties": {
        "windows": { "$ref": "#/$defs/disposition" },
        "macos": { "$ref": "#/$defs/disposition" },
        "linux": { "$ref": "#/$defs/disposition" }
      }
    },
    "status": { "enum": ["draft", "approved", "retired"] }
  },
  "$defs": { "disposition": { "enum": ["required", "equivalent", "degraded", "unavailable", "not-applicable"] } }
}
